{
  "name": "yuuki-bot",
  "version": "2.2.0",
  "description": "WhatsApp Bot",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 index.js",
    "start:optimized": "node --max-old-space-size=4096 --optimize-for-size --gc-interval=100 index.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session && npm start",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force",
    "admin": "node admin/server.js",
    "admin:pm2": "pm2 start admin/server.js --name yuuki-admin --watch --ignore-watch=\"node_modules logs session temp tmp .git\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "push-stats": "node scripts/push-stats.js",
    "docker:build": "docker build -t yuuki-bot.",
    "docker:run": "docker run -e SESSION_ID=$SESSION_ID yuuki-bot"
  },
  "keywords": [
    "whatsapp-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "awesome-phonenumber": "^5.9.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "betabotz-tools": "^0.0.7",
    "btch-downloader": "^6.0.25",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "cookie": "^0.5.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "events": "^3.3.0",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "gtts": "^0.2.1",
    "human-readable": "^0.2.1",
    "instagram-url-downloader": "^1.1.0",
    "jimp": "^1.6.0",
